--- a/css/LibraryNavigationPanel.css	2026-07-16 07:04:17.236024076 +0200
+++ b/css/LibraryNavigationPanel.css	2026-07-16 07:04:17.240024153 +0200
@@ -180,3 +180,57 @@
 .enyo-sliding {
  	/* -webkit-box-shadow: #000 0px 0px 12px !important; */
 }
+
+/* webos-synergy-revival: per-service Library icons (Box, Dropbox, kDrive, Yandex Disk, OneDrive) */
+.library-navigation-icon-boxnet {
+	height: 40px;
+	width: 40px;
+	background-image: url(../images/icon_boxnet_40x40.png);
+}
+.library-navigation-icon-dropbox {
+	height: 40px;
+	width: 40px;
+	background-image: url(../images/icon_dropbox_40x40.png);
+}
+.library-navigation-icon-20x20-boxnet {
+	background-image: url(../images/icon_boxnet_20x20.png);
+}
+.library-navigation-icon-20x20-dropbox {
+	background-image: url(../images/icon_dropbox_20x20.png);
+}
+.library-navigation-icon-kdrive {
+	height: 40px;
+	width: 40px;
+	background-image: url(../images/icon_kdrive_40x40.png);
+}
+.library-navigation-icon-20x20-kdrive {
+	background-image: url(../images/icon_kdrive_20x20.png);
+}
+.library-navigation-icon-yandexdisk {
+	height: 40px;
+	width: 40px;
+	background-image: url(../images/icon_yandexdisk_40x40.png);
+}
+.library-navigation-icon-20x20-yandexdisk {
+	background-image: url(../images/icon_yandexdisk_20x20.png);
+}
+.library-navigation-icon-onedrive {
+	height: 40px;
+	width: 40px;
+	background-image: url(../images/icon_onedrive_40x40.png);
+}
+.library-navigation-icon-20x20-onedrive {
+	background-image: url(../images/icon_onedrive_20x20.png);
+}
+.library-navigation-icon-mega {
+	height: 40px;
+	width: 40px;
+	background-image: url(../images/icon_mega_40x40.png);
+}
+.library-navigation-icon-20x20-mega {
+	background-image: url(../images/icon_mega_20x20.png);
+}
+
+/* Stop short (<40px-tall) provider icons from tiling vertically, which paints a repeated
+   sliver/"mirror" at the bottom (Dropbox 40x37, Yandex 40x26). box/kdrive are 40x40 so were
+   unaffected; no-repeat+center fixes all uniformly. */
+.library-navigation-icon-boxnet,
+.library-navigation-icon-dropbox,
+.library-navigation-icon-kdrive,
+.library-navigation-icon-yandexdisk,
+.library-navigation-icon-mega,
+.library-navigation-icon-onedrive {
+	background-repeat: no-repeat;
+	background-position: center;
+}
