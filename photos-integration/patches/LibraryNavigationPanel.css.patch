+.library-navigation-icon-20x20-dropbox    { background-image: url(/usr/palm/public/accounts/com.palm.dropbox/images/dropbox-48x48.png); }
+.library-navigation-icon-20x20-kdrive     { background-image: url(/usr/palm/public/accounts/com.palm.kdrive/images/kdrive-48x48.png); }
+.library-navigation-icon-20x20-onedrive   { background-image: url(/usr/palm/public/accounts/com.palm.onedrive/images/onedrive-48x48.png); }
+.library-navigation-icon-20x20-yandexdisk { background-image: url(/usr/palm/public/accounts/com.palm.yandexdisk/images/yandexdisk-48x48.png); }
