+.library-navigation-icon-boxnet,
+.library-navigation-icon-dropbox,
+.library-navigation-icon-kdrive,
+.library-navigation-icon-onedrive,
+.library-navigation-icon-yandexdisk,
+.library-navigation-icon-mega,
+.library-navigation-icon-koofr,
