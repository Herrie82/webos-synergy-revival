+.library-navigation-icon-yandexdisk { background-image: url(/usr/palm/public/accounts/com.palm.yandexdisk/images/yandexdisk-48x48.png); }
+.library-navigation-icon-mega       { background-image: url(/usr/palm/public/accounts/com.palm.mega/images/mega-48x48.png); }
+.library-navigation-icon-koofr      { background-image: url(/usr/palm/public/accounts/com.palm.koofr/images/koofr-48x48.png); }
