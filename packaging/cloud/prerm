#!/bin/sh
# prerm — shared by every cloud connector package. Removes the account template + service
# postinst copied out of cryptofs to their real root-fs destinations (ipkg's own automatic
# per-file removal doesn't know about them: by the time postinst finished, they were no longer
# part of this package's own tracked data.tar.gz contents).
set +e
# Anchor at / -- the App Installer runs pm*Install/Remove scripts with cwd set to the package's
# app directory, which install/removal steps can delete out from under us; GNU tar (and anything
# else calling getcwd()) then fails even on unrelated work. Confirmed live in the core-apps repo
# (GH issue #4); defensive here since this family never operates on its own cwd today.
cd /
BAK=/media/cryptofs/synergy-stock-backup
log() { echo "[synergy-cloud] $*"; }

mount -o remount,rw /dev/mapper/store-root / 2>/dev/null
mount -o remount,rw / 2>/dev/null

# Derived the same way as postinst (direct /usr/lib/ipkg/info/<pkg-id>.prerm, or Preware/WebOS
# Quick Install's offline-root .../pmPreRemove.script) -- see postinst's matching comment.
case "$0" in
  */pmPreRemove.script) PKGID="$(basename "$(dirname "$0")")" ;;
  *.prerm) PKGID="$(basename "$0" .prerm)" ;;
  *) PKGID="" ;;
esac
APPLIED="/media/cryptofs/synergy-revival/applied-paths.$PKGID.list"

# Stop the transport before touching anything - see generic/postinst's matching comment: writing
# OR removing a file the running transport already has mmap'd has been confirmed live to corrupt
# it on this cryptofs FUSE filesystem (0-byte file, crash-looping the transport until fixed by
# hand). Only some cloud connectors ship a dedicated auth app (no backend .so of their own), but
# this is cheap and matches the install-side postinst pattern exactly, so just always do it.
stop imtransport 2>/dev/null

if [ -f "$APPLIED" ]; then
  while IFS= read -r dst; do
    [ -n "$dst" ] || continue
    if [ -e "$BAK$dst" ]; then
      mv -f "$BAK$dst" "$dst" && log "  restored stock $dst"
    else
      rm -rf "$dst" && log "  removed $dst"
    fi
  done < "$APPLIED"
  rm -f "$APPLIED"
fi

start imtransport 2>/dev/null
# Backgrounded -- this script runs inside LunaSysMgr's own request handling for the removal, so a
# synchronous `-n 1` wait here is a circular wait with no timeout: confirmed live (GH issue #6) as
# exactly this line, in a prerm, hanging both the install/remove chain and the whole UI
# indefinitely ("Downloading/Updating" never clears) until the blocked luna-send was killed by
# hand. The rescan is only a nudge; nothing below depends on it having completed.
( luna-send -n 1 luna://com.palm.applicationManager/rescan '{}' >/dev/null 2>&1 & ) >/dev/null 2>&1
log "removal complete."
exit 0
