#!/bin/sh
# postinst — shared by every cloud connector package. The account template + legacy Mojo-style
# service land on real root-fs paths (/usr/palm/public/accounts/..., /usr/palm/services/...),
# which stock webOS boots read-only -- ipkg extracts data.tar.gz itself, before this script ever
# runs and gets a chance to remount root rw, so they're staged on cryptofs instead
# (stage_account/stage_service in packaging/lib/common.sh) and copied into place here.
set +e
# Anchor at / -- the App Installer runs pm*Install/Remove scripts with cwd set to the package's
# app directory, which install/removal steps can delete out from under us; GNU tar (and anything
# else calling getcwd()) then fails even on unrelated work. Confirmed live in the core-apps repo
# (GH issue #4); defensive here since this family never operates on its own cwd today.
cd /

# Derive our own package id from how this script was invoked: either the direct-install path
# (/usr/lib/ipkg/info/<pkg-id>.postinst, confirmed live) or the Preware/WebOS Quick Install
# offline-root path (/media/cryptofs/apps/.scripts/<pkg-id>/pmPostInstall.script -- ipkg's
# offline-root mode skips running control.tar.gz's own postinst entirely, confirmed live). $OV is
# scoped per-package at build time by exactly this same id (packaging/lib/common.sh's
# overwrite_rel(), keyed by $PKG_ID), so this looks up EXACTLY our own staged subdirectory instead
# of blindly taking whichever one of the 12 cloud connectors' subdirectories happens to exist --
# unsafe if more than one package's staged data is ever present at once.
case "$0" in
  */pmPostInstall.script) PKGID="$(basename "$(dirname "$0")")" ;;
  *.postinst) PKGID="$(basename "$0" .postinst)" ;;
  *) PKGID="" ;;
esac

BAK=/media/cryptofs/synergy-stock-backup
log() { echo "[synergy-cloud] $*"; }

mount -o remount,rw /dev/mapper/store-root / 2>/dev/null
mount -o remount,rw / 2>/dev/null

# Preware/WebOS Quick Install's offline-root ipkg invocation (`ipkg -o /media/cryptofs/apps
# install <ipk>`) prepends /media/cryptofs/apps to EVERY path in the archive - including paths
# that already start with media/cryptofs/... (APP_ROOT, used by connectors with a dedicated auth
# app like flickr/kdrive/mega/s3, see packaging/lib/common.sh), producing a DOUBLED prefix
# (/media/cryptofs/apps/media/cryptofs/...) that nothing else ever looks at: confirmed live
# elsewhere in this repo, a connector's companion app staged this way was invisible to App
# Manager. ipkg's own native extraction does this, before any postinst runs, so there's no
# manifest to check - just detect and merge the doubled tree back into place. A DIRECT
# (non-offline-root) ipkg install never creates this, so this is a no-op there.
#
# MUST run before $OV is computed below, not after: confirmed live this was the actual cause of
# "staged dir not found - install produced nothing" for connectors with a dedicated auth app
# (Mega, reported by real users after installing 0.9.3). $OV's lookup checks the doubled path too,
# so it can find and record $OV pointing INSIDE .../apps/media/cryptofs/... -- if this merge then
# runs afterward, it physically moves (and deletes) that exact directory out from under the
# already-computed $OV string, leaving it pointing at nothing.
fix_doubled_apps_prefix() {
  local doubled="/media/cryptofs/apps/media/cryptofs"
  [ -d "$doubled" ] || return 0
  log "found doubled offline-root path $doubled - merging back into /media/cryptofs"
  local d name
  for d in "$doubled"/*; do
    [ -e "$d" ] || continue
    name="$(basename "$d")"
    mkdir -p "/media/cryptofs/$name"
    cp -a "$d/." "/media/cryptofs/$name/"
  done
  rm -rf "$doubled"
}
fix_doubled_apps_prefix

# Belt-and-suspenders for anything NOT under media/cryptofs/... that still got staged directly
# instead of through stage_root_file (e.g. /var/imwrap.sh - confirmed live: doubled to
# /media/cryptofs/apps/var/imwrap.sh, leaving imlibpurpletransport's own dbus Exec= launcher
# missing and the whole transport unable to start). All current stage.sh scripts route through
# stage_root_file/overwrite_rel() now (immune by construction), so this should be a permanent
# no-op - kept only as a safety net against a future regression.
fix_doubled_var_prefix() {
  local doubled="/media/cryptofs/apps/var"
  [ -d "$doubled" ] || return 0
  log "found doubled offline-root path $doubled - merging back into /var"
  cp -a "$doubled/." /var/
  rm -rf "$doubled"
}
fix_doubled_var_prefix

OV=""
if [ -n "$PKGID" ]; then
  for _ov_base in /media/cryptofs/synergy-revival/rootfs-overwrite /media/cryptofs/apps/media/cryptofs/synergy-revival/rootfs-overwrite; do
    [ -d "$_ov_base/$PKGID" ] && OV="$_ov_base/$PKGID" && break
  done
fi
# Fallback (should never trigger -- kept only in case PKGID derivation ever fails for an
# invocation pattern this session didn't see): old "first match" behavior.
if [ -z "$OV" ]; then
  for _ov_d in /media/cryptofs/synergy-revival/rootfs-overwrite/*/ /media/cryptofs/apps/media/cryptofs/synergy-revival/rootfs-overwrite/*/; do
    [ -d "$_ov_d" ] && OV="${_ov_d%/}" && break
  done
fi

# APPLIED is a *persistent* manifest that outlives $OV (wiped below), scoped by the same PKGID
# (this same postinst file is shared verbatim across all 12 cloud connectors) so it doesn't
# accumulate every OTHER connector's entries.
APPLIED="/media/cryptofs/synergy-revival/applied-paths.$PKGID.list"

# See generic/postinst's matching function for the full rationale (same mechanism, shared here
# since each package's postinst is a standalone script with no way to source another package's
# files at install time).
apply_rootfs_overwrite() {
  # This whole script runs under `set +e` (a failed step shouldn't abort a postinst mid-way
  # through other packages' installs), which means a corrupted/truncated ipk transfer during
  # install (confirmed live elsewhere: a bad transfer left com.palm.app.messaging silently
  # "installed" into an EMPTY directory, both ipkg and its postinst reporting success) would
  # otherwise go completely unnoticed here too - $OV missing or empty just silently applied
  # nothing while the rest of this script still logged "installed" and exited 0. Fail loudly
  # instead: require $OV to hold at least one file/symlink to apply, and verify the number of
  # paths actually recorded in $APPLIED matches what we found to apply.
  if [ ! -d "$OV" ]; then
    # WebOSQuickInstall (confirmed live, see other postinst scripts in this repo) runs
    # pmPostInstall.script a SECOND time itself, after the real App-Installer-driven install
    # already ran it once and cleaned up $OV - a second run legitimately finds nothing staged,
    # which is not a real failure. $APPLIED (written on success below, never cleaned up here -
    # only prerm removes it) records what the first run actually applied; if its first entry is
    # still on disk, this is that harmless redundant second run, not a failed install.
    if [ -s "$APPLIED" ] && [ -e "$(head -n 1 "$APPLIED")" ]; then
      log "nothing newly staged - already installed (see $APPLIED), treating as a no-op"
      return 0
    fi
    echo "!! apply_rootfs_overwrite: staged dir $OV not found - install produced nothing" >&2
    return 1
  fi
  local expected
  expected=$(find "$OV" -type f ! -name .symlinks | wc -l)
  local expected_links=0
  [ -s "$OV/.symlinks" ] && expected_links=$(wc -l < "$OV/.symlinks")
  if [ "$expected" -eq 0 ] && [ "$expected_links" -eq 0 ]; then
    echo "!! apply_rootfs_overwrite: $OV has no files to apply - likely a corrupted/truncated transfer" >&2
    return 1
  fi

  mkdir -p "$(dirname "$APPLIED")"
  : > "$APPLIED"
  local f rel dst
  find "$OV" -type f | while IFS= read -r f; do
    rel="${f#"$OV"}"
    [ "$rel" = "/.symlinks" ] && continue
    dst="$rel"
    if [ -e "$dst" ] && [ ! -e "$BAK$dst" ]; then
      mkdir -p "$(dirname "$BAK$dst")"
      cp -a "$dst" "$BAK$dst"
      log "  backed up stock $dst"
    fi
    mkdir -p "$(dirname "$dst")"
    rm -f "$dst"
    cp -a "$f" "$dst"
    echo "$dst" >> "$APPLIED"
  done
  if [ -s "$OV/.symlinks" ]; then
    while IFS="$(printf '\t')" read -r dst target; do
      [ -n "$dst" ] || continue
      mkdir -p "$(dirname "$dst")"
      rm -f "$dst"
      ln -sf "$target" "$dst"
      echo "$dst" >> "$APPLIED"
    done < "$OV/.symlinks"
  fi

  local applied
  applied=$(wc -l < "$APPLIED" 2>/dev/null || echo 0)
  rm -rf "$OV"
  if [ "$applied" -lt "$((expected + expected_links))" ]; then
    echo "!! apply_rootfs_overwrite: only applied $applied of $((expected + expected_links)) expected path(s) - possible partial/corrupted install" >&2
    return 1
  fi
  log "applied $applied path(s)"
  return 0
}
if ! apply_rootfs_overwrite; then
  echo "!! [synergy-cloud] postinst failed - install did not complete correctly, try reinstalling" >&2
  exit 1
fi

# Backgrounded, not `-n 1` awaited synchronously: this script runs INSIDE LunaSysMgr's own
# request handling for the install (it's the process that owes applicationManager's reply), so a
# synchronous wait here is a circular wait with no timeout -- confirmed live elsewhere in this
# family (packaging/generic/postinst): the install chain and the whole UI hang indefinitely until
# someone kills the luna-send by hand. The rescan is only a nudge; nothing below depends on it.
( luna-send -n 1 luna://com.palm.applicationManager/rescan '{}' >/dev/null 2>&1 & ) >/dev/null 2>&1
# ls-hubd only scans /usr/share/dbus-1/system-services/*.service (and the LS2 role dirs) at its
# OWN startup, not on every filesystem change -- confirmed against ls-control's own help text
# ("scan-services: tell the hub to rescan for dynamic services"). Without this, a freshly-
# installed connector's NEW com.palm.service.<x>.service file sits on disk correctly but ls-hubd
# doesn't know it exists until the device reboots (which restarts ls-hubd too): reported live as
# "Service not listed in service files: com.palm.service.mega" from a caller other than the one
# that happened to trigger account setup (account setup can go through a different LS2 path that
# doesn't need this service listed yet -- login succeeding is not proof this ran).
ls-control scan-services 2>/dev/null
for p in $(pidof accounts.js 2>/dev/null); do kill "$p" 2>/dev/null; done
echo "[synergy-cloud] installed. Settings > Accounts > Add Account to finish setup."
exit 0
