#!/bin/sh
# postinst — CardDAV/CalDAV connector. Adapted from carddav/deploy/deploy-cdav.sh's own
# cdav-postinstall.sh (the extraction step is now ipkg's data.tar.gz unpack; everything after
# that is unchanged).
set +e
SVCID=org.webosports.service.cdav
APPID=org.webosports.app.cdav
# $OV is scoped per-package at build time (packaging/lib/common.sh's overwrite_rel(), keyed by
# $NAME) -- ipkg's file-ownership tracking is by exact path regardless of whether the file still
# physically exists after postinst deletes it, so a shared literal path collides across packages
# (confirmed live: dropbox failed with ".symlinks... already provided by package
# org.webosports.synergy.generic" even though generic's own postinst had already deleted its
# copy). Glob for whichever subdirectory THIS package's data.tar.gz actually populated -- ipkg
# fully installs+configures one package before starting the next, so there's never a moment where
# two packages' subdirectories coexist here.
OV=""
for _ov_d in /media/cryptofs/synergy-revival/rootfs-overwrite/*/ /media/cryptofs/apps/media/cryptofs/synergy-revival/rootfs-overwrite/*/; do
  [ -d "$_ov_d" ] && OV="${_ov_d%/}" && break
done
BAK=/media/cryptofs/synergy-stock-backup

mount -o remount,rw /dev/mapper/store-root / 2>/dev/null
mount -o remount,rw / 2>/dev/null

# The service/ls2-roles/dbus-activation/db8-kinds/permissions/account-templates all land on real
# root-fs paths, which stock webOS boots read-only -- ipkg extracts data.tar.gz itself, before
# this script ever runs and gets a chance to remount root rw, so stage.sh staged them on cryptofs
# instead (stage_root_file/stage_root_dir in packaging/lib/common.sh). Copy them into place now,
# before anything below assumes they already exist. See generic/postinst's matching function for
# the full rationale (same mechanism, duplicated here since each package's postinst is a
# standalone script with no way to source another package's files at install time). carddav's
# prerm already hardcodes the exact set of paths to clean up (no manifest needed here).
apply_rootfs_overwrite() {
  [ -d "$OV" ] || return 0
  local f rel dst
  find "$OV" -type f | while IFS= read -r f; do
    rel="${f#"$OV"}"
    [ "$rel" = "/.symlinks" ] && continue
    dst="$rel"
    if [ -e "$dst" ] && [ ! -e "$BAK$dst" ]; then
      mkdir -p "$(dirname "$BAK$dst")"
      cp -a "$dst" "$BAK$dst"
    fi
    mkdir -p "$(dirname "$dst")"
    rm -f "$dst"
    cp -a "$f" "$dst"
  done
  if [ -s "$OV/.symlinks" ]; then
    while IFS="$(printf '\t')" read -r dst target; do
      [ -n "$dst" ] || continue
      mkdir -p "$(dirname "$dst")"
      rm -f "$dst"
      ln -sf "$target" "$dst"
    done < "$OV/.symlinks"
  fi
  rm -rf "$OV"
}
echo "[cdav] applying staged service/roles/dbus/db8/account files..."
apply_rootfs_overwrite

if [ ! -f /usr/palm/services/$SVCID/services.json ]; then
  echo "[cdav] !! service files missing after install — aborting provisioning"
  exit 1
fi

echo "[cdav] provisioning db8 kinds + permissions..."
chmod +x /var/provision-cdav-db.sh 2>/dev/null
sh /var/provision-cdav-db.sh

echo "[cdav] rescanning luna-service2 roles..."
ls-control scan-services 2>/dev/null || echo "   (ls-control scan-services not available)"

echo "[cdav] registering the setup app + reloading Accounts templates..."
luna-send -n 1 palm://com.palm.applicationManager/rescan '{}' >/dev/null 2>&1
luna-send -n 1 palm://com.palm.appinstaller/notifyAppInstalled '{"appId":"'$APPID'"}' >/dev/null 2>&1
luna-send -n 1 palm://com.palm.appinstaller/notifyAppInstalled '{"appId":"'$SVCID'"}' >/dev/null 2>&1
for p in $(ps 2>/dev/null | grep 'accounts.js' | grep -v grep | awk '{print $1}'); do kill "$p" 2>/dev/null; done
sleep 2
luna-send -n 1 palm://com.palm.service.accounts/listAccountTemplates '{}' >/dev/null 2>&1

echo "[cdav] (re)starting the service..."
for p in $(ps 2>/dev/null | grep "$SVCID" | grep -v grep | awk '{print $1}'); do kill "$p" 2>/dev/null; done
luna-send -n 1 -f palm://$SVCID/checkStatus '{"accountId":"install-ping"}' >/dev/null 2>&1 &
sleep 4

# Deliberately NOT remounting root back to read-only here -- ipkg writes its own bookkeeping
# after postinst returns, and that needs root writable too (confirmed on a real device: doing
# this remount broke ipkg's own status/file-list write, failing the whole transaction even
# though postinst itself had finished all its real work). See packaging/generic/postinst.
echo "[cdav] install complete. If a template didn't appear in Accounts, restart LunaSysMgr or reboot."
exit 0
