#!/bin/sh
# prerm — CardDAV/CalDAV connector. Stops the service and removes what postinst installed.
# Leaves synced contacts/calendar data in the stock Contacts/Calendar db8 kinds alone (db8
# kinds/permissions this package registered are left inert, matching the generic package's
# convention — only a reflash fully clears those).
set +e
# Anchor at / -- the App Installer runs pm*Install/Remove scripts with cwd set to the package's
# app directory, which install/removal steps can delete out from under us; GNU tar (and anything
# else calling getcwd()) then fails even on unrelated work. Confirmed live in the core-apps repo
# (GH issue #4); defensive here since this family never operates on its own cwd today.
cd /
SVCID=org.webosports.service.cdav
APPID=org.webosports.app.cdav

for p in $(ps 2>/dev/null | grep "$SVCID" | grep -v grep | awk '{print $1}'); do kill "$p" 2>/dev/null; done

mount -o remount,rw / 2>/dev/null
rm -rf /usr/palm/services/$SVCID
rm -f /usr/share/ls2/roles/pub/$SVCID.json /usr/share/ls2/roles/prv/$SVCID.json
rm -f /usr/share/dbus-1/system-services/$SVCID.service /usr/share/dbus-1/services/$SVCID.service
rm -rf /usr/palm/public/accounts/org.webosports.cdav.account*
rm -rf /media/cryptofs/apps/usr/palm/applications/$APPID
rm -f /var/provision-cdav-db.sh
# Deliberately NOT remounting root back to read-only here -- see packaging/generic/prerm.

ls-control scan-services 2>/dev/null
# Backgrounded -- this script runs inside LunaSysMgr's own request handling for the removal; see
# packaging/cloud/prerm's matching comment (GH issue #6) for the circular-wait deadlock this
# avoids. The rescan is only a nudge; nothing below depends on it having completed.
( luna-send -n 1 palm://com.palm.applicationManager/rescan '{}' >/dev/null 2>&1 & ) >/dev/null 2>&1
echo "[cdav] removal complete."
exit 0
