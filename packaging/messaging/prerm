#!/bin/sh
# prerm — shared by every messaging (libpurple) connector package. Removes the account template +
# calling dbus service file postinst copied out of cryptofs to their real root-fs destinations
# (ipkg's own automatic per-file removal doesn't know about them: by the time postinst finished,
# they were no longer part of this package's own tracked data.tar.gz contents).
set +e
BAK=/media/cryptofs/synergy-stock-backup
log() { echo "[synergy-messaging] $*"; }

mount -o remount,rw /dev/mapper/store-root / 2>/dev/null
mount -o remount,rw / 2>/dev/null

# Derived the same way as postinst (direct /usr/lib/ipkg/info/<pkg-id>.prerm, or Preware/WebOS
# Quick Install's offline-root .../pmPreRemove.script) -- see postinst's matching comment.
case "$0" in
  */pmPreRemove.script) PKGID="$(basename "$(dirname "$0")")" ;;
  *.prerm) PKGID="$(basename "$0" .prerm)" ;;
  *) PKGID="" ;;
esac
APPLIED="/media/cryptofs/synergy-revival/applied-paths.$PKGID.list"

# Stop the transport before touching anything - see generic/postinst's matching comment: writing
# OR removing a file the running transport already has mmap'd has been confirmed live to corrupt
# it on this cryptofs FUSE filesystem (0-byte file, crash-looping the transport until fixed by
# hand). $APPLIED for a messaging connector always includes its own backend plugin .so under
# synergy-purple-plugins/synergy-runtime, which the transport has dlopen'd for as long as it's
# been running - matches the install-side postinst pattern exactly.
stop imtransport 2>/dev/null

if [ -f "$APPLIED" ]; then
  while IFS= read -r dst; do
    [ -n "$dst" ] || continue
    if [ -e "$BAK$dst" ]; then
      mv -f "$BAK$dst" "$dst" && log "  restored stock $dst"
    else
      rm -rf "$dst" && log "  removed $dst"
    fi
  done < "$APPLIED"
  rm -f "$APPLIED"
fi

start imtransport 2>/dev/null
luna-send -n 1 luna://com.palm.applicationManager/rescan '{}' >/dev/null 2>&1
log "removal complete."
exit 0
