#!/bin/sh
# prerm — generic package. Stops the shared transport and restores the stock files that
# postinst patched (from the .orig/.b4* backups it made). Leaves user data (messages, contacts,
# db8 records) alone. Best-effort: every step logs and continues on failure.
set +e
# Anchor at / -- the App Installer runs pm*Install/Remove scripts with cwd set to the package's
# app directory, which install/removal steps can delete out from under us; GNU tar (and anything
# else calling getcwd()) then fails even on unrelated work. Confirmed live in the core-apps repo
# (GH issue #4); defensive here since this family never operates on its own cwd today.
cd /
log() { echo "[synergy-generic] $*"; }
# Derived the same way as postinst (direct /usr/lib/ipkg/info/<pkg-id>.prerm, or Preware/WebOS
# Quick Install's offline-root .../pmPreRemove.script) -- see postinst's matching comment for why
# APPLIED needs this per-package scoping.
case "$0" in
  */pmPreRemove.script) PKGID="$(basename "$(dirname "$0")")" ;;
  *.prerm) PKGID="$(basename "$0" .prerm)" ;;
  *) PKGID="" ;;
esac

log "stopping imtransport..."
stop imtransport 2>/dev/null
stop bt-a2dp-fix 2>/dev/null

mount -o remount,rw /dev/mapper/store-root / 2>/dev/null
mount -o remount,rw / 2>/dev/null

log "restoring patched stock files from backups..."
# Copy the backup to a temp file NEXT TO the destination, then atomically mv (rename) it over --
# the same pattern, for the same reason, as postinst's webkit-webm-mime step: several of these
# destinations are live-mmap'd RIGHT NOW. libWebKitLuna.so is mapped by LunaSysMgr, WebAppMgr and
# BrowserServer (and this script runs inside LunaSysMgr's own request handling); HeiT_nb.ttf by
# every FreeType user. A plain `cp backup dest` truncates the live inode and rewrites it in
# place, so any mapper faulting a page during the window (or past the truncation point) dies with
# SIGBUS -- confirmed live (GH issue #8): removing/replacing generic SIGBUS-crashed WebAppMgr,
# LunaSysMgr and BrowserServer in sequence, aborting Preware batch installs. rename() keeps every
# current mapper on the old inode until it exits; only new opens see the restored file. Also
# fixes restoring PmBtEngine while it runs: cp onto a running executable fails ETXTBSY, mv works.
# The [ -e dst ] guard: the single .prewebm backup is aimed at BOTH candidate libWebKitLuna.so
# paths below, but postinst only ever patched the one that existed -- blindly cp'ing CREATED a
# spare 12.8MB copy at the other path on the tiny (559MB) root partition.
restore() {
  [ -f "$1" ] || return 0
  [ -e "$2" ] || return 0
  cp "$1" "$2.synergy-restore.$$" && mv -f "$2.synergy-restore.$$" "$2" && log "  restored $2"
  rm -f "$2.synergy-restore.$$" 2>/dev/null
}

restore /usr/share/fonts/HeiT_nb.ttf.orig /usr/share/fonts/HeiT_nb.ttf
restore /usr/bin/PmBtEngine.orig /usr/bin/PmBtEngine
restore /media/internal/libWebKitLuna.so.prewebm /usr/lib/libWebKitLuna.so
restore /media/internal/libWebKitLuna.so.prewebm /usr/palm/lib/libWebKitLuna.so
for f in /usr/palm/frameworks/mediastream/submission/24mediastream.js \
         /usr/palm/frameworks/mediastream/submission/24/concatenated.js \
         /usr/palm/frameworks/mediastream/submission/24/javascript/StreamingPlayEngine.js; do
  restore "$f.orig" "$f"
done

log "restoring the retired Skype stack (non-destructive move, reversible)..."
SKYBAK=/media/cryptofs/skype-disabled-backup
if [ -d "$SKYBAK" ]; then
  ( cd "$SKYBAK" && find . \( -type f -o -type l \) | while read -r f; do
      mkdir -p "$(dirname "/${f#./}")"
      mv -f "$f" "/${f#./}" && log "  restored /${f#./}"
    done )
fi

log "restoring the retired AOL/AIM + Yahoo! stacks (non-destructive move, reversible)..."
LEGBAK=/media/cryptofs/legacy-im-disabled-backup
if [ -d "$LEGBAK" ]; then
  ( cd "$LEGBAK" && find . \( -type f -o -type l \) | while read -r f; do
      mkdir -p "$(dirname "/${f#./}")"
      mv -f "$f" "/${f#./}" && log "  restored /${f#./}"
    done )
fi
# liboscar.so/liboscar.so.0 were deleted outright, not backed up (/media/cryptofs can't hold
# symlinks) -- recreate them if the real target came back above.
if [ -f /usr/lib/purple-2/liboscar.so.0.0.0 ]; then
  ln -sf liboscar.so.0.0.0 /usr/lib/purple-2/liboscar.so.0
  ln -sf liboscar.so.0.0.0 /usr/lib/purple-2/liboscar.so
  log "  restored liboscar.so/liboscar.so.0 symlinks"
fi

log "restoring the retired stock Google account (non-destructive move, reversible)..."
GOOGBAK=/media/cryptofs/google-legacy-disabled-backup
if [ -d "$GOOGBAK" ]; then
  ( cd "$GOOGBAK" && find . \( -type f -o -type l \) | while read -r f; do
      mkdir -p "$(dirname "/${f#./}")"
      mv -f "$f" "/${f#./}" && log "  restored /${f#./}"
    done )
fi
# libjabber.so/libjabber.so.0 were deleted outright, not backed up (same reason as oscar above).
if [ -f /usr/lib/purple-2/libjabber.so.0.0.0 ]; then
  ln -sf libjabber.so.0.0.0 /usr/lib/purple-2/libjabber.so.0
  ln -sf libjabber.so.0.0.0 /usr/lib/purple-2/libjabber.so
  log "  restored libjabber.so/libjabber.so.0 symlinks"
fi

log "restoring stock files (or removing what we added if there was no stock file)..."
STOCKBAK=/media/cryptofs/synergy-stock-backup
APPLIED="/media/cryptofs/synergy-revival/applied-paths.$PKGID.list"
restore_or_remove() {  # $1 = real absolute path we may have overwritten in postinst
  local dst="$1"
  if [ -e "$STOCKBAK$dst" ]; then
    mv -f "$STOCKBAK$dst" "$dst" && log "  restored stock $dst"
  else
    rm -f "$dst"
  fi
}
# libpurple.so/libpurple.so.0 are symlinks -- postinst never backed them up (/media/cryptofs can't
# hold symlinks at all, and there's nothing to back up anyway: the real stock target file
# libpurple.so.0.5.1 was never touched). Just re-link back to it directly if libpurple.so.0.14.13
# is about to be removed below, confirmed the stock name/version on every real image checked
# (StockRootfs + two physical devices).
if [ -f /media/cryptofs/synergy-stock-backup/usr/lib/libpurple.so.0.14.13 ] || [ -f /usr/lib/libpurple.so.0.14.13 ]; then
  rm -f /usr/lib/libpurple.so.0 /usr/lib/libpurple.so
  if [ -f /usr/lib/libpurple.so.0.5.1 ]; then
    ln -sf libpurple.so.0.5.1 /usr/lib/libpurple.so.0
    ln -sf libpurple.so.0.5.1 /usr/lib/libpurple.so
    log "  restored stock symlinks -> libpurple.so.0.5.1"
  fi
fi
if [ -f "$APPLIED" ]; then
  while IFS= read -r dst; do
    [ -n "$dst" ] || continue
    restore_or_remove "$dst"
  done < "$APPLIED"
fi
# $STOCKBAK is SHARED across every synergy package (cloud/messaging postinst also write into it,
# keyed by the same literal destination paths - see packaging/lib/common.sh's overwrite_rel()
# comment on why $APPLIED is per-PKGID but this legacy backup dir never was). The restore loop
# above already moved out everything THIS package put there; do not rm -rf the shared directory
# itself here - confirmed live as a real bug: doing so while any cloud/messaging connector was
# still installed deleted ITS not-yet-restored backups too, silently corrupting its own future
# uninstall. Only remove our own manifest.
rm -f "$APPLIED"

log "removing imlibpurpleservice + backend files..."
# NOT listed here: /usr/bin/imlibpurpletransport, /var/imwrap.sh and
# /etc/event.d/imtransport. All three are staged through the overwrite mechanism, so
# they are already in $APPLIED and the restore loop above has just dealt with them --
# putting stock back where stock existed, removing ours where it did not.
#
# Deleting them here on top of that was destructive, not redundant. restore_or_remove
# uses `mv`, which CONSUMES the backup, so for imlibpurpletransport the sequence was:
# restore stock -> backup now gone -> rm the file we just restored. Stock ships that
# binary (see stage.sh's own note), and com.palm.imlibpurple.service is restored
# pointing at it -- so an uninstall left a live D-Bus activation record aimed at a
# deleted binary, with no backup left to recover from. Stock IM was broken until a
# reflash.
rm -f /var/imdaemon.sh /var/provision-im-db.sh \
      /var/provision-im-reactions.sh /var/provision-person-search.sh
rm -f /usr/sbin/bt-a2dp-fix.sh /etc/event.d/bt-a2dp-fix /usr/local/bin/db8-clean.sh
# /usr/lib/purple-2 and /usr/lib/synergy-runtime are BIND MOUNTS onto /media/cryptofs (see
# postinst/imwrap.sh) -- unmount FIRST, or `rm -rf` here would recurse through the mount and
# delete the real cryptofs-backed content instead of just the (by-then-empty) mountpoint dir.
# -l (lazy, MNT_DETACH; supported by this BusyBox): a PLAIN umount fails EBUSY if anything still
# holds the mount (e.g. a transport that outlived the `stop` above), silently leaving the mount
# in place, the rmdir below failing, and a stale mountpoint surviving the uninstall. MNT_DETACH
# detaches the name immediately while keeping existing open files/mappings valid until their
# holders exit, so it cannot hurt a straggler either. (Raised by GH issue #8; note the SIGBUS
# crashes reported there came from the old in-place-cp restore() above, not from these lines --
# a plain umount can never yank a mount that still has live mappings, it just fails.)
umount -l /usr/lib/purple-2 2>/dev/null
umount -l /usr/lib/synergy-runtime 2>/dev/null
rmdir /usr/lib/purple-2 /usr/lib/synergy-runtime 2>/dev/null
rm -rf /usr/palm/services/_cloudcore
# /media/cryptofs/synergy-revival is SHARED across every synergy package (rootfs-overwrite/<pkg-id>
# staging + applied-paths.<pkg-id>.list for cloud/messaging/carddav too - see packaging/lib/
# common.sh's overwrite_rel()). Wholesale rm -rf here was a real bug: uninstalling generic while
# any other synergy package was still installed deleted THEIR applied-paths.*.list manifests too,
# leaving their own future uninstall with nothing to restore/remove from (silently orphaning
# whatever they'd overwritten). Only remove what's unambiguously ours: our own already-emptied OV
# dir (apply_rootfs_overwrite already rm -rf'd it during postinst; harmless if already gone) and
# device-setup (generic's own payload area, not shared). Then rmdir the parent - a no-op unless
# generic happens to be the LAST synergy package removed, in which case it's actually empty.
rm -rf "/media/cryptofs/synergy-revival/rootfs-overwrite/$PKGID" /media/cryptofs/synergy-revival/device-setup
rmdir /media/cryptofs/synergy-revival/rootfs-overwrite /media/cryptofs/synergy-revival 2>/dev/null

# Deliberately NOT remounting root back to read-only here -- ipkg writes its own bookkeeping
# after prerm returns, and that needs root writable too. See postinst's matching comment.

log "removal complete. NOTE: db8 kinds/permissions and the retired Skype db8 kinds are left"
log "registered (inert, harmless) — only a reflash fully clears those."
exit 0
