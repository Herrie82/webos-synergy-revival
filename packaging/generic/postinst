    patch_in "$d" "$Q/patches/FolderContentsPane.js.patch" 2>/dev/null || log "  !! FolderContentsPane.js patch failed for $app (already applied?)"
    cp "$Q/assets/toolbar-icon-refresh.png" "$d/images/" 2>/dev/null
