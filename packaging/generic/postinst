    cp "$DS/gst-video-codecs/prebuilt/$so" "/usr/lib/gstreamer-0.10/$so" 2>/dev/null
  done
fi
rm -f ~/.gstreamer-0.10/registry.*.bin /home/root/.gstreamer-0.10/registry.*.bin 2>/dev/null

