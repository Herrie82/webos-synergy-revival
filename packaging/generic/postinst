luna-send -n 1 luna://com.palm.applicationManager/rescan '{}' >/dev/null 2>&1
# Deliberately NOT remounting root back to read-only here: ipkg writes ITS OWN bookkeeping
# (status db, file lists under /usr/lib/ipkg/{status,info}) AFTER postinst returns, and that
# write also needs root writable. Remounting ro from inside postinst races ipkg's own
# finalization -- confirmed on a real device: ipkg failed with "Read-only file system" writing
# its status/file-list right after this used to run, so the whole transaction reported failure
# (return 29) even though postinst itself had already done all its real work correctly. Leave the
# rw/ro decision to the system; don't force it from here.

log "install complete. Restart the UI to pick up patched app/framework JS: stop LunaSysMgr; start LunaSysMgr"
exit 0
