# ---------------------------------------------------------------- device-setup: videoplayer-webm
if [ -d "$DS/videoplayer-webm/src" ]; then
  log "videoplayer-webm: mislabeling webm/mkv in the mediastream framework..."
  for f in /usr/palm/frameworks/mediastream/submission/24mediastream.js \
           /usr/palm/frameworks/mediastream/submission/24/concatenated.js \
           /usr/palm/frameworks/mediastream/submission/24/javascript/StreamingPlayEngine.js; do
    [ -f "$f" ] || continue
    if grep -q 'video/ogg' "$f" 2>/dev/null && grep -q '_msrc' "$f" 2>/dev/null; then
      log "  already patched: $f"; continue
    fi
    [ -f "$f.orig" ] || cp "$f" "$f.orig"
    # Pure sh/awk (patch-mediastream.sh), not python3 -- confirmed on a real device that python3
    # isn't installed at all, which made this silently fail on every file, every time.
    sh "$DS/videoplayer-webm/src/patch-mediastream.sh" "$f" && log "  patched: $f" || log "  !! failed: $f"
  done
  # The autoplug shim (libmp-autoplug.so) is intentionally NOT installed here: it fixes WebM in the
  # stock Video player but BREAKS mp4/H.264 playback. Apply it manually per
  # device-setup/videoplayer-webm/README.md (MP_SHIM) if you need WebM more than mp4.
  stop mediaserver 2>/dev/null; sleep 1; start mediaserver 2>/dev/null
fi

# ---------------------------------------------------------------- device-setup: webkit-webm-mime
# Binary string patch of libWebKitLuna.so (video/x-ms-wmv -> video/webm); no payload file.
# libWebKitLuna.so is a core, actively-mmap'd OS library (the running WebKit engine) -- patch a
# COPY on the same filesystem, verify it, then atomically `mv` it over the original. A process
# with the old file already open/mapped keeps using that inode until it reopens; writing bytes
# directly into the live inode in place risks a torn read by whatever has it mapped right now.
log "webkit-webm-mime: patching libWebKitLuna.so MIME table..."
LIB=$(ls /usr/lib/libWebKitLuna.so /usr/palm/lib/libWebKitLuna.so 2>/dev/null | head -1)
if [ -n "$LIB" ]; then
  if strings "$LIB" 2>/dev/null | grep -q "^video/webm$"; then
    log "  already patched"
  else
    OFF=$(find_byte_offset "$LIB" "video/x-ms-wmv")
    if [ -n "$OFF" ]; then
      cp "$LIB" /media/internal/libWebKitLuna.so.prewebm 2>/dev/null
      TMP="$LIB.webmpatch.$$"
      cp -a "$LIB" "$TMP"
      printf 'video/webm\000\000\000\000' | dd of="$TMP" bs=1 seek="$OFF" count=14 conv=notrunc 2>/dev/null
      if strings "$TMP" 2>/dev/null | grep -q "^video/webm$"; then
        mv -f "$TMP" "$LIB" && log "  patched OK"
      else
        log "  !! patch verify failed on copy, leaving original untouched"
        rm -f "$TMP"
      fi
    else
      log "  !! target string not found, skipping (unexpected libWebKitLuna build)"
    fi
  fi
fi

# ---------------------------------------------------------------- device-setup: whatsapp-e164-normalization
# The messaging.library code fix itself moved to the core-apps package (deployed from core-apps'
