  [ -f /usr/share/fonts/HeiT_nb.ttf.orig ] || cp /usr/share/fonts/HeiT_nb.ttf /usr/share/fonts/HeiT_nb.ttf.orig 2>/dev/null
  cp "$DS/fonts/NotoSansThai-Regular.ttf" /usr/share/fonts/HeiT_nb.ttf 2>/dev/null
