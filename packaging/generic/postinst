# patch_in <dir> <patch-file> -- BusyBox's `patch` does NOT support `-d` at all (confirmed on a
# real device: "patch: invalid option -- 'd'"), unlike GNU patch. `patch -p1 -d DIR < file` was
# silently failing on EVERY call below (the 2>/dev/null hid the busybox usage-error output),
# misreported in the log as "already applied?" when the patches were never applied at all. cd in
# a subshell instead, which works with any patch implementation.
patch_in() {
  ( cd "$1" && patch -p1 ) < "$2"
}

