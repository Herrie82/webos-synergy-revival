#!/bin/sh
# postinst — generic package. Runs as root via Preware/ipkg (NOT palm-install). Wires up
# imlibpurpleservice + the shared libpurple backend, cloudcore, QuickOffice/Photos/DocViewer
# integration, and the device-setup/* fixes. All steps are idempotent; a failed step logs and
# continues rather than aborting the whole install (best-effort, matches how these were
# originally applied by hand over novacom).
set +e
DS=/media/cryptofs/synergy-revival/device-setup

# Derive our own package id from how this script was invoked: either the direct-install path
# (/usr/lib/ipkg/info/<pkg-id>.postinst, confirmed live) or the Preware/WebOS Quick Install
# offline-root path (/media/cryptofs/apps/.scripts/<pkg-id>/pmPostInstall.script -- ipkg's
# offline-root mode skips running control.tar.gz's own postinst entirely, confirmed live; that's
# what pmPostInstall.script, added as a top-level ar member by make-ipk.sh, is FOR). $OV is scoped
# per-package at build time by exactly this same id (packaging/lib/common.sh's overwrite_rel(),
# keyed by $PKG_ID) so this looks up EXACTLY our own staged subdirectory -- not just "whichever
# subdirectory happens to have one", which is unsafe if more than one package's staged data is
# ever present at once (not something this session could verify either way for the App Installer's
# real batching behavior, so guard against it rather than assume single-package-at-a-time).
case "$0" in
  */pmPostInstall.script) PKGID="$(basename "$(dirname "$0")")" ;;
  *.postinst) PKGID="$(basename "$0" .postinst)" ;;
  *) PKGID="" ;;
esac

OV=""
if [ -n "$PKGID" ]; then
  for _ov_base in /media/cryptofs/synergy-revival/rootfs-overwrite /media/cryptofs/apps/media/cryptofs/synergy-revival/rootfs-overwrite; do
    [ -d "$_ov_base/$PKGID" ] && OV="$_ov_base/$PKGID" && break
  done
fi
# Fallback (should never trigger given the above -- kept only in case PKGID derivation ever fails
# for an invocation pattern this session didn't see): old "first match" behavior.
if [ -z "$OV" ]; then
  for _ov_d in /media/cryptofs/synergy-revival/rootfs-overwrite/*/ /media/cryptofs/apps/media/cryptofs/synergy-revival/rootfs-overwrite/*/; do
    [ -d "$_ov_d" ] && OV="${_ov_d%/}" && break
  done
fi
BAK=/media/cryptofs/synergy-stock-backup
log() { echo "[synergy-generic] $*"; }

# APPLIED is a *persistent* manifest that outlives $OV (which gets wiped below), scoped by the
# same PKGID so it doesn't accumulate every OTHER connector's entries -- otherwise every
# connector's prerm would see (and try to remove) all of them.
APPLIED="/media/cryptofs/synergy-revival/applied-paths.$PKGID.list"

# Copies everything staged under $OV (by stage_root_file/stage_root_dir/stage_account/
# stage_service in packaging/lib/common.sh) to its real root-fs destination, backing up whatever
# is already there once. Must run before anything below assumes those files already exist --
# ipkg's own data.tar.gz unpack never touches a root-fs path directly (nothing writes there
# anymore), so if this step doesn't run, none of them are anywhere on the device yet.
#
# Also appends every destination path touched to APPLIED (a manifest that OUTLIVES $OV itself,
# which this wipes clean at the end -- see the stale-leftover-subdir bug this exact pattern hit in
# the core-apps repo's packaging). prerm reads APPLIED (not $OV, which won't exist by the time
# prerm runs) to know what to restore-or-remove.
apply_rootfs_overwrite() {
  # This whole script runs under `set +e` (a failed step shouldn't abort a postinst mid-way
  # through other packages' installs), which means a corrupted/truncated ipk transfer during
  # install (confirmed live elsewhere: a bad transfer left com.palm.app.messaging silently
  # "installed" into an EMPTY directory, both ipkg and its postinst reporting success) would
  # otherwise go completely unnoticed here too - $OV missing or empty just silently applied
  # nothing while the rest of this script still logged "installed" and exited 0. Fail loudly
  # instead: require $OV to hold at least one file/symlink to apply, and verify the number of
  # paths actually recorded in $APPLIED matches what we found to apply.
  if [ ! -d "$OV" ]; then
    echo "!! apply_rootfs_overwrite: staged dir $OV not found - install produced nothing" >&2
    return 1
  fi
  local expected
  expected=$(find "$OV" -type f ! -name .symlinks | wc -l)
  local expected_links=0
  [ -s "$OV/.symlinks" ] && expected_links=$(wc -l < "$OV/.symlinks")
  if [ "$expected" -eq 0 ] && [ "$expected_links" -eq 0 ]; then
    echo "!! apply_rootfs_overwrite: $OV has no files to apply - likely a corrupted/truncated transfer" >&2
    return 1
  fi

  mkdir -p "$(dirname "$APPLIED")"
  : > "$APPLIED"
  local f rel dst
  find "$OV" -type f | while IFS= read -r f; do
    rel="${f#"$OV"}"
    [ "$rel" = "/.symlinks" ] && continue
    dst="$rel"
    if [ -e "$dst" ] && [ ! -e "$BAK$dst" ]; then
      mkdir -p "$(dirname "$BAK$dst")"
      cp -a "$dst" "$BAK$dst"
      log "  backed up stock $dst"
    fi
    mkdir -p "$(dirname "$dst")"
    rm -f "$dst"
    cp -a "$f" "$dst"
    echo "$dst" >> "$APPLIED"
  done
  if [ -s "$OV/.symlinks" ]; then
    while IFS="$(printf '\t')" read -r dst target; do
      [ -n "$dst" ] || continue
      mkdir -p "$(dirname "$dst")"
      rm -f "$dst"
      ln -sf "$target" "$dst"
      echo "$dst" >> "$APPLIED"
    done < "$OV/.symlinks"
  fi

  local applied
  applied=$(wc -l < "$APPLIED" 2>/dev/null || echo 0)
  rm -rf "$OV"
  if [ "$applied" -lt "$((expected + expected_links))" ]; then
    echo "!! apply_rootfs_overwrite: only applied $applied of $((expected + expected_links)) expected path(s) - possible partial/corrupted install" >&2
    return 1
  fi
  log "applied $applied path(s)"
  return 0
}

# find_byte_offset <file> <literal-string> -- print the byte offset of the first occurrence of
# <literal-string> in <file> (exit 1, no output, if not found). BusyBox's grep has no -b (byte
# offset) at all (confirmed: "grep: invalid option -- 'b'"), this device's BusyBox has no `od`
# applet at all ("od: not found" -- confirmed live; only `hexdump` is built in), and BusyBox
# `strings -o` (decimal offset) has a real off-by bug whenever a run of NUL bytes as long as the
# -n minimum precedes a match -- confirmed empirically (offset drifted from 7 bytes off on a small
# test file to tens of millions of bytes off on the real 12.8MB libWebKitLuna.so, whose reported
# offset came back larger than the file itself).
#
# So: two linear coarse scans (outer in 2MB steps, inner in 64KB steps, each step overlapping the
# next by len(target)-1 bytes so a match straddling a step boundary is never missed) use dd
# (block-aligned reads -- fast, binary-safe) + grep -ac (binary-safe, C-fast) to narrow down to a
# small window; a fine phase then does an exact hexdump-as-text + awk byte-array scan (NUL-safe
# because hexdump's output is plain ASCII hex text, unlike the raw binary content) on just that
# window. Full-file hexdump+awk alone was verified correct but timed out (>2min) on the 12.8MB
# library. Critical gotcha: BusyBox dd's count= is in whole bs-sized blocks, so a requested
# length that isn't an exact multiple of bs gets silently rounded UP -- every boundary this
# function narrows to MUST use that true rounded-up length (not the originally-requested one), or
# a match sitting in the overshoot region produces a false "found" that then wrongly excludes the
# real match from the narrowed window (confirmed: this exact bug produced an empty final result
# against the real library on an earlier version of this function).
chunk_has() {  # $1=file $2=start $3=length $4=target $5=blocksize -> prints match count (0/1+)
  local file="$1" start="$2" length="$3" target="$4" bs="$5" skipb countb
  skipb=$(( start / bs ))
  countb=$(( (length + bs - 1) / bs ))
  dd if="$file" bs=$bs skip="$skipb" count="$countb" 2>/dev/null | grep -ac -- "$target"
}

find_byte_offset() {
  local file="$1" target="$2"
  local tlen filelen overlap OUTER INNER pos end has winlen relOff target_hex countb newend

  tlen=$(printf '%s' "$target" | wc -c)
  filelen=$(wc -c < "$file")
  overlap=$(( tlen - 1 ))
  OUTER=2097152
  INNER=65536

  pos=0
  while [ "$pos" -lt "$filelen" ]; do
    has=$(chunk_has "$file" "$pos" $((OUTER + overlap)) "$target" "$INNER")
    if [ "${has:-0}" -ge 1 ]; then
      countb=$(( (OUTER + overlap + INNER - 1) / INNER ))
      end=$(( pos + countb * INNER ))
      [ "$end" -gt "$filelen" ] && end=$filelen
      break
    fi
    pos=$(( pos + OUTER ))
  done
  [ "$pos" -ge "$filelen" ] && return 1

  while [ $(( pos + INNER )) -lt "$end" ]; do
    has=$(chunk_has "$file" "$pos" $((INNER + overlap)) "$target" "$INNER")
    if [ "${has:-0}" -ge 1 ]; then
      countb=$(( (INNER + overlap + INNER - 1) / INNER ))
      newend=$(( pos + countb * INNER ))
      [ "$newend" -lt "$end" ] && end=$newend
      break
    fi
    pos=$(( pos + INNER ))
  done

  winlen=$(( end - pos ))
  [ "$winlen" -le 0 ] && return 1
  target_hex="$(printf '%s' "$target" | hexdump -v -e '1/1 "%02x "')"
  target_hex="$(printf '%s' "$target_hex" | sed 's/^ *//; s/ *$//')"
  relOff=$(dd if="$file" bs=1 skip="$pos" count="$winlen" 2>/dev/null | hexdump -v -e '16/1 "%02x " "\n"' | awk -v target="$target_hex" '
    BEGIN { n = split(target, want, " ") }
    { for (i = 1; i <= NF; i++) bytes[++count] = $i }
    END {
      for (start = 1; start <= count - n + 1; start++) {
        matched = 1
        for (i = 1; i <= n; i++) { if (bytes[start + i - 1] != want[i]) { matched = 0; break } }
        if (matched) { print start - 1; exit 0 }
      }
      exit 1
    }
  ')
  [ -n "$relOff" ] || return 1
  echo $(( pos + relOff ))
}

mount -o remount,rw /dev/mapper/store-root / 2>/dev/null
mount -o remount,rw / 2>/dev/null

# Stop the transport BEFORE any of the overwrite/bind-mount work below touches libpurple.so,
# purple-2/, or synergy-runtime -- confirmed live (see packaging/messaging/postinst's matching
# comment): writing into a file the RUNNING transport already has mmap'd produced a 0-byte file on
# this cryptofs FUSE filesystem, crash-looping the transport until fixed by hand. Only matters on
# a reinstall/upgrade of an already-installed generic (a fresh install has nothing running yet);
# restarted later once the real db8/ls2 provisioning below has also run.
stop imtransport 2>/dev/null
pkill -9 -f imlibpurpletransport 2>/dev/null

# ---------------------------------------------------------------- purple-2 / synergy-runtime
# bind mounts: root (/dev/mapper/store-root) is a FIXED, TINY 559MB partition; connector plugins
# are large enough (WhatsApp/Telegram ~29MB each, Signal ~19.5MB) that keeping them there fills it
# -- confirmed live: installing teams+telegram+signal+whatsapp together left 0 bytes free and
# broke further installs (one mid-install segfault, one corrupted ipkg package record).
# /media/cryptofs has 20+GB free on the same device, so the real storage for both dirs lives there
# (staged there by every package -- see BACKEND_PURPLE2/BACKEND_LIB in packaging/lib/common.sh);
# this bind-mounts them onto the /usr/lib paths libpurple.so and imwrap.sh's LD_LIBRARY_PATH
# actually expect. Not a symlink: /media/cryptofs cannot hold them (confirmed elsewhere in this
# postinst). Bind mounts don't survive a reboot, so imwrap.sh re-establishes both on every
# transport launch too (see its own copy of this same check) -- this postinst-time setup just
# gets a freshly-installed device working immediately without requiring a reboot first.
for PAIR in "synergy-purple-plugins:/usr/lib/purple-2" "synergy-runtime:/usr/lib/synergy-runtime"; do
  CDIR="/media/cryptofs/${PAIR%%:*}"
  MNT="${PAIR#*:}"
  mkdir -p "$CDIR" "$MNT"
  mount | grep -q " on $MNT type" || mount --bind "$CDIR" "$MNT"
done

# ---------------------------------------------------------------- rootfs-overwrite
# Applies EVERYTHING staged under $OV in one pass: the libpurple 2.14 + ssl-openssl engine
# (overwrites real /usr/lib + /usr/lib/purple-2 -- genuine stock com.palm.imlibpurple
# infrastructure being modernized in place, not a private add-on), com.palm.imlibpurple.service,
# the patched com.palm.person kind, imlibpurpletransport itself, db8 kinds/permissions, ls2
# roles, activities, and _cloudcore -- every one of these is now a real root-fs path that ipkg's
# own data.tar.gz unpack can't write directly (root boots read-only), so nothing at any of these
# destinations exists yet until this runs. Backs up whatever's already at each destination ONCE
# (idempotent: skip if a backup already exists from a prior install) so prerm can restore it,
# matching the non-destructive move pattern already used by device-setup's skype-disable /
# bt-hfg-call-patch / webkit-webm-mime fixes.
log "applying staged root-fs files (libpurple engine, db8 kinds/permissions, ls2 roles, _cloudcore, imlibpurpletransport)..."
if ! apply_rootfs_overwrite; then
  echo "!! [generic] postinst failed - install did not complete correctly, try reinstalling" >&2
  exit 1
fi

# ---------------------------------------------------------------- imlibpurpleservice
log "registering messaging db8 kinds/permissions..."
chmod 755 /var/imwrap.sh /var/imdaemon.sh /var/provision-im-db.sh /var/provision-im-reactions.sh \
  /var/provision-person-search.sh 2>/dev/null
/var/provision-im-db.sh
/var/provision-person-search.sh
luna-send -n 1 luna://com.palm.applicationManager/rescan '{}' >/dev/null 2>&1

log "starting imtransport upstart job..."
start imtransport 2>/dev/null

# account-keepdata patching moved to the core-apps package, which deploys the whole
# com.palm.service.accounts from the app-services repo (now the single source of truth).

# ---------------------------------------------------------------- device-setup: bt-a2dp-fix
if [ -f "$DS/bt-a2dp-fix/bt-a2dp-fix.sh" ]; then
  log "bt-a2dp-fix: installing daemon..."
  cp "$DS/bt-a2dp-fix/bt-a2dp-fix.sh" /usr/sbin/bt-a2dp-fix.sh
  chmod 755 /usr/sbin/bt-a2dp-fix.sh
  cp "$DS/bt-a2dp-fix/bt-a2dp-fix.upstart" /etc/event.d/bt-a2dp-fix
  pkill -f bt-a2dp-fix.sh 2>/dev/null
  stop bt-a2dp-fix 2>/dev/null; start bt-a2dp-fix 2>/dev/null
fi

# ---------------------------------------------------------------- device-setup: bt-hfg-call-patch
# 1-byte PmBtEngine patch (com.palm.skype -> ANY transport) so BT hands-free call audio isn't
# gated to Skype. See device-setup/bt-hfg-call-patch/README.md. No payload file; pure byte patch.
log "bt-hfg-call-patch: patching PmBtEngine (BT HFG transport gate)..."
BIN=/usr/bin/PmBtEngine
if [ -f "$BIN" ]; then
  printf '\061\000\000\012' > /tmp/.hfg_before
  printf '\061\000\000\352' > /tmp/.hfg_after
  dd if="$BIN" bs=1 skip=119792 count=4 2>/dev/null > /tmp/.hfg_got
  if cmp -s /tmp/.hfg_got /tmp/.hfg_after; then
    log "  already patched"
  elif cmp -s /tmp/.hfg_got /tmp/.hfg_before; then
    stop bluetooth 2>/dev/null; sleep 2
    kill $(pidof PmBtEngine PmBtStack BluetoothMonitor) 2>/dev/null; sleep 2
    [ -f "$BIN.orig" ] || cp "$BIN" "$BIN.orig"
    printf '\352' | dd of="$BIN" bs=1 seek=119795 count=1 conv=notrunc 2>/dev/null
    dd if="$BIN" bs=1 skip=119792 count=4 2>/dev/null > /tmp/.hfg_got2
    cmp -s /tmp/.hfg_got2 /tmp/.hfg_after && log "  patched OK" || { log "  patch FAILED, restoring"; cp "$BIN.orig" "$BIN"; }
    start bluetooth 2>/dev/null
  else
    log "  !! unexpected PmBtEngine build, skipping (see device-setup/bt-hfg-call-patch/README.md)"
  fi
  rm -f /tmp/.hfg_before /tmp/.hfg_after /tmp/.hfg_got /tmp/.hfg_got2
fi

