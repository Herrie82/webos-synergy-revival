  log "gst-plugins-base-audioresample: installing audioresample element..."
  cp "$DS/gst-plugins-base-audioresample/prebuilt/libgstaudioresample.so" /usr/lib/gstreamer-0.10/libgstaudioresample.so 2>/dev/null
