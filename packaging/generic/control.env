PKG_ID=com.palm.synergy.generic
PKG_VERSION=0.9.3
# Anyone who set up imlibpurpleservice by hand before this packaging system existed has an old
# standalone "imlibpurpleservice" ipkg package (no relation to a stock package) claiming
# /usr/bin/imlibpurpletransport + several db8 kinds/activities this package also ships. Without
# this, ipkg refuses the whole install with "file already provided by package imlibpurpleservice"
# -- confirmed on a real device. Replaces+Conflicts lets ipkg transition it automatically.
PKG_REPLACES="imlibpurpleservice"
PKG_CONFLICTS="imlibpurpleservice"
PKG_DESC="webOS Synergy Revival - shared runtime (imlibpurpleservice + libpurple backend, cloudcore, QuickOffice/Photos/DocViewer integration, device-setup fixes). Required by every other com.palm.synergy.* connector package."
